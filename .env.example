# ═══════════════════════════════════════════════════════════════
# LINE - Auditor Médico Digital
# Configuración de Variables de Entorno
# ═══════════════════════════════════════════════════════════════
# Copie este archivo como .env y complete los valores:
#   cp .env.example .env
# ═══════════════════════════════════════════════════════════════

# ── NVIDIA Nemotron (LLM Externo) ─────────────────────────────
# API Key para el modelo NVIDIA Nemotron-3
# Obtener en: https://build.nvidia.com/explore/discover
# Obligatorio para usar el modo Nemotron
NVIDIA_API_KEY=

# Modelo de NVIDIA a utilizar (por defecto: nvidia/nemotron-3-nano-30b-a3b)
NVIDIA_MODEL=nvidia/nemotron-3-nano-30b-a3b

# ── CORS (Seguridad) ──────────────────────────────────────────
# Orígenes permitidos para CORS (separados por coma)
# Ejemplo: http://localhost:8000,https://line.ips.com
# Por defecto: * (todos los orígenes - solo para desarrollo)
CORS_ORIGINS=*

# ── Base de Datos ─────────────────────────────────────────────
# Motor de base de datos: sqlite | sqlserver | mysql
DB_ENGINE=sqlite

# Rutas para SQLite (solo si DB_ENGINE=sqlite)
# DB_PATH=linea.db

# Configuración para SQL Server (solo si DB_ENGINE=sqlserver)
# DB_SERVER=localhost
# DB_DATABASE=line_auditor
# DB_USER=sa
# DB_PASSWORD=

# Configuración para MySQL (solo si DB_ENGINE=mysql)
# DB_HOST=localhost
# DB_PORT=3306
# DB_DATABASE=line_auditor
# DB_USER=root
# DB_PASSWORD=

# ── Rutas de Archivos ─────────────────────────────────────────
# Ruta al archivo de historia clínica detalle (CSV)
# HC_DETALLE_PATH=data/03_historia_clinica_detalle.csv

# Ruta al archivo de prefactura original (referencia)
# PF_ORIGINAL_PATH=data/04_prefactura.csv

# ── Logging (ISO 27001 A.8.15) ────────────────────────────────
# Nivel de logging: DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO

# Archivo de log (dejar vacío para consola solamente)
# LOG_FILE=logs/line.log

# ── Seguridad Adicional ───────────────────────────────────────
# Tasa límite de requests por minuto (Rate Limiting)
# RATE_LIMIT_PER_MINUTE=60
