# ── CONFIGURACIÓN DE BASE DE DATOS ─────────────────────────────────────
# Opciones: sqlite, sqlserver, mysql
DB_ENGINE=sqlite

# SQLite (por defecto para desarrollo)
DB_PATH=./linea.db

# SQL Server (para producción)
# DB_ENGINE=sqlserver
# DB_SERVER=your_server_name
# DB_DATABASE=your_database_name
# DB_USER=your_username
# DB_PASSWORD=your_password
# DB_DRIVER=ODBC Driver 17 for SQL Server

# MySQL (para producción)
# DB_ENGINE=mysql
# DB_HOST=localhost
# DB_PORT=3306
# DB_DATABASE=your_database_name
# DB_USER=your_username
# DB_PASSWORD=your_password

# ── RUTAS DE ARCHIVOS DE DATOS (CAMBIAR EN PRODUCCIÓN) ────────────────
# Historia Clínica Detalle - CSV externo o tabla de BD
HC_DETALLE_PATH=./data/historia_clinica_detalle.csv

# Prefactura Original - CSV de referencia
PF_ORIGINAL_PATH=./data/prefactura.csv

# Dataset Maestro - Para construir BD inicial
DATASET_MAESTRO_PATH=./data/dataset_maestro.csv

# ── NVIDIA API para Nemotron ────────────────────────────────────────────
NVIDIA_API_KEY=tu_api_key_aqui
NVIDIA_MODEL=nvidia/nemotron-3-nano-8b-v1

# ── Apitude API para BDUA (opcional) ────────────────────────────────────
APITUDE_KEY=tu_api_key_apitude_aqui
